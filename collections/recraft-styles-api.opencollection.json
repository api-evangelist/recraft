{
  "opencollection": "1.0.0",
  "info": {
    "name": "Recraft Images Styles API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Styles",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Create style",
