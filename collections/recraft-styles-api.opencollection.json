            "body": {
              "type": "multipart-form",
              "data": [
                {
                  "name": "style",
                  "type": "text",
                  "value": ""
                },
                {
                  "name": "files",
                  "type": "text",
                  "value": ""
                }
              ]
            }
          },
          "docs": "Create style"
        }
      ]
    }
  ],
  "bundled": true
}